{
  "name": "mcp-dev-agent",
  "version": "1.0.0",
  "description": "Servidor MCP (Streamable HTTP) que expoe a um agente de IA as mesmas capacidades de desenvolvimento de um agente Claude Code: executar comandos, editar/mover/listar arquivos, usar node/npm/gh.",
  "type": "module",
  "bin": {
    "mcp-dev-agent": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
