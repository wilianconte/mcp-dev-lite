# Serviço systemd para o servidor MCP.
# Gere este unit com scripts/render-systemd-unit.sh. O usuario padrao e root por compatibilidade.
[Unit]
Description=MCP dev-agent (Streamable HTTP)
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__REPO_DIR__
# EnvironmentFile deve conter MCP_AUTH_TOKEN=... (chmod 600). PORT e os demais
# overrides operacionais sao renderizados pelo script abaixo.
EnvironmentFile=__REPO_DIR__/.env
# PATH explicito: garante que o servidor E os comandos rodados via run_command
# usem o mesmo toolchain (node/npm v22) que o usuario usa no shell, nao o node do sistema.
Environment=PATH=__NODE_BIN__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=MCP_RUN_USER=__RUN_USER__
Environment=PORT=__PORT__
Environment=PUBLIC_URL=__PUBLIC_URL__
Environment=MCP_DATA_DIR=__DATA_DIR__
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=__PORT__ PUBLIC_URL=__PUBLIC_URL__ MCP_DATA_DIR=__DATA_DIR__ __NODE_BIN__/node __REPO_DIR__/dist/server.js
# always: reinicia mesmo em saida "limpa" (ex.: SIGTERM externo), nao so em falha.
# systemctl stop continua funcionando normalmente (stop explicito nunca dispara restart).
Restart=always
RestartSec=5
# Escuta so em loopback; o cloudflared faz a ponte para a internet.
Environment=HOST=127.0.0.1

[Install]
WantedBy=multi-user.target
