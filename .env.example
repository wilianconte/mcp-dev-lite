# Copie para .env e ajuste. NUNCA versione o .env real.
# Gere um token forte: openssl rand -hex 32
MCP_AUTH_TOKEN=troque-por-um-token-secreto-forte
PORT=3000
HOST=0.0.0.0
# URL publica HTTPS (issuer OAuth e resource do MCP). Obrigatoria em producao.
PUBLIC_URL=https://seu-host
# Senha pedida na tela de aprovacao OAuth (ChatGPT). Se omitida, usa o MCP_AUTH_TOKEN.
OAUTH_APPROVAL_PASSWORD=troque-por-uma-senha-forte
# Limite de imagem para read_image, em bytes. Padrao interno: 10 MiB.
MCP_MAX_IMAGE_BYTES=10485760
# Limite combinado capturado de stdout/stderr por run_command, em bytes. Padrao interno: 50 MiB.
MCP_COMMAND_MAX_BUFFER_BYTES=52428800
# Proxy confiavel pelo Express. "loopback" e seguro para cloudflared local e e o padrao.
MCP_TRUST_PROXY=loopback
# Opcional: arquivo JSONL de auditoria. Sem valor, auditoria continua no stderr/journald.
# MCP_AUDIT_LOG_PATH=./data/audit.jsonl
# Defina false para nao duplicar auditoria no stderr quando MCP_AUDIT_LOG_PATH estiver configurado.
MCP_AUDIT_STDERR=true
# Opcional: sobrescreve o diretorio de estado OAuth (util em testes/ambientes isolados).
# MCP_DATA_DIR=./data
