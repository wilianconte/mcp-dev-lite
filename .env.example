# Copie para .env e ajuste. NUNCA versione o .env real.
# Gere um token forte: openssl rand -hex 32
MCP_AUTH_TOKEN=troque-por-um-token-secreto-forte
PORT=3000
HOST=0.0.0.0
# URL publica HTTPS (issuer OAuth e resource do MCP). Obrigatoria em producao.
PUBLIC_URL=https://seu-host
# Senha pedida na tela de aprovacao OAuth (ChatGPT). Se omitida, usa o MCP_AUTH_TOKEN.
OAUTH_APPROVAL_PASSWORD=troque-por-uma-senha-forte
