# Copie para .env e ajuste. NUNCA versione o .env real.
# Gere um token forte: openssl rand -hex 32
MCP_AUTH_TOKEN=troque-por-um-token-secreto-forte
# Usuario aplicado pelo unit systemd renderizado. Padrao operacional: root.
MCP_RUN_USER=root
PORT=3000
HOST=0.0.0.0
# URL publica HTTPS (issuer OAuth e resource do MCP). Obrigatoria em producao.
PUBLIC_URL=https://seu-host
# Senha pedida na tela de aprovacao OAuth (ChatGPT). Se omitida, usa o MCP_AUTH_TOKEN.
OAUTH_APPROVAL_PASSWORD=troque-por-uma-senha-forte
# Limite de imagem para read_image, em bytes. Padrao interno: 10 MiB.
MCP_MAX_IMAGE_BYTES=10485760
# Limite de arquivo de texto para read_file / read_files, em bytes. Padrao interno: 10 MiB.
MCP_MAX_TEXT_FILE_BYTES=10485760
# Limite combinado capturado de stdout/stderr por run_command, em bytes. Padrao interno: 50 MiB.
MCP_COMMAND_MAX_BUFFER_BYTES=52428800
# Proxy confiavel pelo Express. "loopback" e seguro para cloudflared local e e o padrao.
MCP_TRUST_PROXY=loopback
# Diretorio base privado para OAuth, auditoria e estado local. Padrao: ./data.
# MCP_DATA_DIR=./data
# Diretorio privado para snapshots de start_command/poll_command. Padrao: /tmp/mcp-dev-agent-jobs.
# MCP_JOB_STORE_DIR=/tmp/mcp-dev-agent-jobs
# Ambiente dos comandos executados. "full" preserva o ambiente do processo, "sanitized" remove chaves sensiveis.
MCP_COMMAND_ENV_MODE=full
# Tentativas de login do painel por IP a cada janela de 15 minutos. Padrao: 10.
# MCP_MONITOR_LOGIN_MAX_ATTEMPTS=10
# Opcional: arquivo JSONL de auditoria. Sem valor, auditoria continua no stderr/journald.
# MCP_AUDIT_LOG_PATH=./data/audit.jsonl
# Tamanho maximo do arquivo JSONL de auditoria antes de rotacionar para .1, em bytes. Padrao interno: 20 MiB.
# MCP_AUDIT_MAX_BYTES=20971520
# Defina false para nao duplicar auditoria no stderr quando MCP_AUDIT_LOG_PATH estiver configurado.
MCP_AUDIT_STDERR=true
# Defina true para incluir eventos de handshake MCP (mcp.initialize, mcp.sse_open, mcp.tools_list) na lista de transacoes do painel /logs.
# MCP_LOG_PROTOCOL_EVENTS=false
