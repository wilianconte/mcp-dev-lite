{
  "name": "mcp-dev-agent",
  "version": "1.5.1",
  "description": "Servidor MCP (Streamable HTTP) que expoe a um agente de IA as mesmas capacidades de desenvolvimento de um agente Claude Code: executar comandos, editar/mover/listar arquivos, usar node/npm/gh.",
  "type": "module",
  "bin": {
    "mcp-dev-agent": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage test/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .prettierrc.json eslint.config.mjs src/version.ts",
    "format:check": "prettier --check .prettierrc.json eslint.config.mjs src/version.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.22.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=20"
  }
}
